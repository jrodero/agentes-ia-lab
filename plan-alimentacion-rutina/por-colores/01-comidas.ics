RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR
END:VEVENT
BEGIN:VEVENT
UID:c-snack-am@plan.claude
DTSTAMP:20260511T200000Z
SUMMARY:🥪 Snack AM
DESCRIPTION:Proteína + fruta.\nEj: yogur griego + 30 g frutos secos + manzana\, o 2 huevos duros + fruta + almendras\, o batido proteína + manzana.\n💧 250 ml antes.
DTSTART;TZID=Europe/Madrid:20260511T103000
DTEND;TZID=Europe/Madrid:20260511T104500
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR
END:VEVENT
BEGIN:VEVENT
UID:c-pre-entreno@plan.claude
DTSTAMP:20260511T200000Z
SUMMARY:🍌 Pre-entreno (1 h antes del gym)
DESCRIPTION:Carbo rápido + algo de proteína.\nEj: banana + tostada con miel\, o 30 g avena + 1 dátil + café.\nSin grasas ni fibra alta.
DTSTART;TZID=Europe/Madrid:20260511T130000
DTEND;TZID=Europe/Madrid:20260511T131500
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR
END:VEVENT
